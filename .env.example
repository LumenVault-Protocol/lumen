# ============================================================
# LumenVault — Stellar-native (Soroban) configuration
# Copy to .env and fill in values. Backend: apps/backend
# ============================================================

# Backend server
PORT=3001
MONGODB_URI=mongodb://localhost:27017/lumenvault

# Stellar network
#   mainnet:   https://soroban-rpc.stellar.org
#   testnet:   https://soroban-testnet.stellar.org
#   futurenet: https://rpc-futurenet.stellar.org
STELLAR_RPC_URL=https://soroban-rpc.stellar.org
STELLAR_NETWORK=Public Global Stellar Network ; September 2015
STELLAR_HORIZON_URL=https://horizon.stellar.org

# Contract deployment (run: npm run deploy:soroban)
# Funded account secret key for the target network (mainnet/testnet/futurenet)
SECRET_KEY=
# Optional wasm path overrides (defaults: contracts/soroban/target/wasm32-unknown-unknown/release)
VAULT_WASM=
STRATEGY_WASM=
RISK_WASM=
FACTORY_WASM=

# Deployed contract addresses (fill after npm run deploy:soroban)
VAULT_FACTORY_ADDRESS=
VAULT_TEMPLATE_ADDRESS=
STRATEGY_LENDING_ADDRESS=
RISK_MANAGER_ADDRESS=